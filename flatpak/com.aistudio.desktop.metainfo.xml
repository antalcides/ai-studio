<component type="desktop-application">
  <id>com.aistudio.desktop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>AI Studio</name>
  <summary>Chat with local and cloud AI models</summary>
  <description>
    <p>AI Studio es una aplicación de escritorio moderna para chatear con modelos de IA locales y en la nube. Conecta fácilmente con:</p>
    <ul>
      <li>Ollama (modelos locales)</li>
      <li>OpenAI (ChatGPT)</li>
      <li>Anthropic (Claude)</li>
      <li>Google Gemini</li>
      <li>LM Studio</li>
      <li>OpenRouter</li>
      <li>Y más...</li>
    </ul>
    <p>Características:</p>
    <ul>
      <li>Interfaz moderna y oscura</li>
      <li>Sin problemas de CORS</li>
      <li>Soporte para múltiples modelos</li>
      <li>Markdown en respuestas</li>
      <li>Configuración persistente</li>
      <li>Exportación de conversaciones</li>
      <li>Menú nativo</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.aistudio.desktop.desktop</launchable>
  <url type="homepage">https://github.com/antalcides/ai-studio</url>
  <url type="bugtracker">https://github.com/antalcides/ai-studio/issues</url>
