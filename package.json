{
  "name": "ai-studio",
  "version": "1.2.0",
  "description": "AI Studio - Aplicación de escritorio para chatear con modelos de IA locales y en la nube (OpenAI, Anthropic, Gemini, Ollama, LM Studio, OpenRouter y más)",
  "main": "electron/main.js",
  "author": {
    "name": "AI Studio",
    "email": "dev@localhost"
  },
  "license": "MIT",
  "homepage": "https://github.com/antalcides/ai-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/antalcides/ai-studio.git"
  },
  "bugs": {
    "url": "https://github.com/antalcides/ai-studio/issues"
  },
  "keywords": [
    "ollama",
    "openai",
    "anthropic",
    "gemini",
    "openrouter",
    "ai",
    "chat",
    "local",
    "cloud",
    "electron",
    "desktop"
  ],
  "scripts": {
    "start": "npx serve public -p 8000",
    "dev": "npx serve public -p 8000 --live",
    "electron": "electron .",
    "electron-dev": "electron . --dev",
    "build": "electron-builder",
    "build-win": "electron-builder --win --x64",
    "build-win-portable": "electron-builder --win portable --x64",
    "build-win-dir": "electron-builder --win dir --x64",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "build-linux-deb": "electron-builder --linux deb --x64",
    "build-linux-appimage": "electron-builder --linux AppImage --x64",
    "build-linux-all": "electron-builder --linux deb AppImage --x64",
    "build-win-simple": "node tools/build-win.js",
    "package-win": "node tools/package-win.js",
    "postinstall": "electron-builder install-app-deps",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "serve": "^14.2.1"
  },
  "build": {
    "appId": "com.aistudio.desktop",
    "productName": "AI Studio",
    "executableName": "ai-studio",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/icon.ico",
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Studio",
      "runAfterFinish": true,
      "installerIcon": "public/assets/icon.ico",
      "uninstallerIcon": "public/assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/assets/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "public/assets/icon.png"
    },
    "deb": {
      "artifactName": "ai-studio_${version}_${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "ai-studio-${version}.${ext}"
    }
  }
}
